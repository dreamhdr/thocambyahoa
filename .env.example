# Cloudflare Pages Environment Variables
# Copy file này thành .env.local để test local (không commit .env.local)

# JWT Secret - Dùng để ký JWT tokens
# Tạo bằng: openssl rand -base64 32
JWT_SECRET=your-random-jwt-secret-here-change-this

# Admin Username
ADMIN_USERNAME=admin@byahoa.com

# Admin Password Hash - SHA-256 hash của mật khẩu
# Tạo bằng: echo -n "YOUR_PASSWORD" | openssl dgst -sha256
# Hoặc dùng script: ./create-password-hash.sh
ADMIN_PASSWORD_HASH=your-password-hash-here

# R2 Public URL - URL công khai của R2 bucket
# Ví dụ: https://media.thocambyahoa.com
# Hoặc: https://pub-xxxxx.r2.dev
R2_PUBLIC_URL=https://media.thocambyahoa.com

# ===================================================
# LƯU Ý:
# - File .env.local chỉ dùng cho development local
# - KHÔNG commit file .env.local vào Git
# - Production environment variables cấu hình trên Cloudflare Dashboard
# - Xem DEPLOYMENT.md để biết cách cấu hình trên Cloudflare
# ===================================================
